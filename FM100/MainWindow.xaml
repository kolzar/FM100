<Window x:Class="FM100.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FM100"
        xmlns:views="clr-namespace:FM100.Views"
        mc:Ignorable="d"
        Title="Football Manager Master League" 
        Height="900" 
        Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e"
        Foreground="White">

    <Grid x:Name="MainGrid">
        <!-- Content Host - Dynamically loads views -->
        <ContentControl x:Name="ViewHost"/>
    </Grid>

</Window>
