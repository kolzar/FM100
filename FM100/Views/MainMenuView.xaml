<UserControl x:Class="FM100.Views.MainMenuView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource PrimaryBackgroundBrush}"
        FontFamily="Segoe UI">
    <Grid>
        <!-- Background Gradient -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1e1e1e" Offset="0"/>
                <GradientStop Color="#2d2d2d" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- Title -->
            <TextBlock Text="⚽ FOOTBALL MANAGER MASTER LEAGUE ⚽" 
                       FontSize="36" 
                       FontWeight="Bold"
                       Foreground="#00d4ff"
                       TextAlignment="Center"
                       Margin="0,0,0,10"/>

            <TextBlock Text="The Road to Glory Starts Here" 
                       FontSize="18" 
                       Foreground="#888888"
                       TextAlignment="Center"
                       Margin="0,0,0,40"/>

            <!-- Buttons Stack -->
            <StackPanel Width="300">
                <!-- New Game Button -->
                <Button Content="🆕 NEW GAME" 
                        Height="50" 
                        FontSize="16"
                        FontWeight="Bold"
                        Background="#00d4ff"
                        Foreground="#000000"
                        Cursor="Hand"
                        Click="NewGame_Click"
                        Margin="0,0,0,15"/>

                <!-- Load Game Button -->
                <Button Content="📁 LOAD GAME" 
                        Height="50" 
                        FontSize="16"
                        FontWeight="Bold"
                        Background="#4a9eff"
                        Foreground="White"
                        Cursor="Hand"
                        Click="LoadGame_Click"
                        Margin="0,0,0,15"/>

                <!-- Settings Button -->
                <Button Content="⚙️ SETTINGS" 
                        Height="50" 
                        FontSize="16"
                        FontWeight="Bold"
                        Background="#666666"
                        Foreground="White"
                        Cursor="Hand"
                        Click="Settings_Click"
                        Margin="0,0,0,15"/>

                <!-- Hall of Fame Button -->
                <Button Content="🏆 HALL OF FAME" 
                        Height="50" 
                        FontSize="16"
                        FontWeight="Bold"
                        Background="#ffd700"
                        Foreground="#000000"
                        Cursor="Hand"
                        Click="HallOfFame_Click"
                        Margin="0,0,0,15"/>

                <!-- Exit Button -->
                <Button Content="❌ EXIT" 
                        Height="50" 
                        FontSize="16"
                        FontWeight="Bold"
                        Background="#cc3333"
                        Foreground="White"
                        Cursor="Hand"
                        Click="Exit_Click"/>
            </StackPanel>

            <!-- Footer -->
            <TextBlock Text="Version 1.0.0 | © 2024 FM100 | Made with ❤️ in .NET 10" 
                       FontSize="12" 
                       Foreground="#666666"
                       TextAlignment="Center"
                       Margin="0,40,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
