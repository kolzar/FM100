<UserControl x:Class="FM100.Views.CoachCreationView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="600" Width="800"
        Background="#0a0e27"
        FontFamily="Segoe UI">
    <Border Background="#0a0e27" Padding="40">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="500">
            <!-- Title -->
            <TextBlock Text="CREATE YOUR COACH" FontSize="32" FontWeight="Bold" 
                      Foreground="#00d4ff" Margin="0,0,0,30" TextAlignment="Center"/>

            <!-- Subtitle -->
            <TextBlock Text="Customize your manager before starting the season" 
                      FontSize="14" Foreground="#b0b0b0" Margin="0,0,0,30" 
                      TextAlignment="Center" TextWrapping="Wrap"/>

            <!-- Coach Name -->
            <TextBlock Text="Coach Name" FontSize="13" FontWeight="Bold" 
                      Foreground="#ffffff" Margin="0,0,0,8"/>
            <TextBox x:Name="CoachNameInput" Height="40" Padding="12,8" 
                    Background="#1a1f3a" Foreground="#ffffff" BorderBrush="#2d3561" 
                    BorderThickness="1" FontSize="13" Margin="0,0,0,20"/>

            <!-- Nationality -->
            <TextBlock Text="Nationality" FontSize="13" FontWeight="Bold" 
                      Foreground="#ffffff" Margin="0,0,0,8"/>
            <ComboBox x:Name="NationalityDropdown" Height="40" Padding="12,8" 
                     Background="#1a1f3a" Foreground="#ffffff" BorderBrush="#2d3561" 
                     BorderThickness="1" FontSize="13" Margin="0,0,0,20">
                <ComboBoxItem>Italian</ComboBoxItem>
                <ComboBoxItem>Spanish</ComboBoxItem>
                <ComboBoxItem>German</ComboBoxItem>
                <ComboBoxItem>French</ComboBoxItem>
                <ComboBoxItem>English</ComboBoxItem>
                <ComboBoxItem>Portuguese</ComboBoxItem>
                <ComboBoxItem>Dutch</ComboBoxItem>
                <ComboBoxItem>Belgian</ComboBoxItem>
                <ComboBoxItem>Other</ComboBoxItem>
            </ComboBox>

            <!-- Preferred Formation -->
            <TextBlock Text="Preferred Formation" FontSize="13" FontWeight="Bold" 
                      Foreground="#ffffff" Margin="0,0,0,8"/>
            <ComboBox x:Name="FormationDropdown" Height="40" Padding="12,8" 
                     Background="#1a1f3a" Foreground="#ffffff" BorderBrush="#2d3561" 
                     BorderThickness="1" FontSize="13" Margin="0,0,0,20">
                <ComboBoxItem>4-3-3</ComboBoxItem>
                <ComboBoxItem>4-2-3-1</ComboBoxItem>
                <ComboBoxItem>3-5-2</ComboBoxItem>
                <ComboBoxItem>5-3-2</ComboBoxItem>
                <ComboBoxItem>4-1-4-1</ComboBoxItem>
            </ComboBox>

            <!-- Personality -->
            <TextBlock Text="Personality" FontSize="13" FontWeight="Bold" 
                      Foreground="#ffffff" Margin="0,0,0,8"/>
            <ComboBox x:Name="PersonalityDropdown" Height="40" Padding="12,8" 
                     Background="#1a1f3a" Foreground="#ffffff" BorderBrush="#2d3561" 
                     BorderThickness="1" FontSize="13" Margin="0,0,0,30">
                <ComboBoxItem>Aggressive</ComboBoxItem>
                <ComboBoxItem>Balanced</ComboBoxItem>
                <ComboBoxItem>Defensive</ComboBoxItem>
                <ComboBoxItem>Charismatic</ComboBoxItem>
                <ComboBoxItem>Strict</ComboBoxItem>
            </ComboBox>

            <!-- Info Box -->
            <Border Background="#2a2f4a" Padding="15" CornerRadius="5" Margin="0,0,0,30">
                <TextBlock Text="ℹ️ You can customize your coach's attributes and tactics after starting the season." 
                          Foreground="#b0b0b0" FontSize="11" TextWrapping="Wrap"/>
            </Border>

            <!-- Buttons -->
            <Grid Height="50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Start Game Button -->
                <Button x:Name="StartButton" Grid.Column="0" Content="START SEASON" 
                       Background="#00d4ff" Foreground="Black" FontSize="13" FontWeight="Bold" 
                       Cursor="Hand" Click="StartButton_Click"/>

                <!-- Back Button -->
                <Button x:Name="BackButton" Grid.Column="2" Content="BACK" 
                       Background="#666666" Foreground="White" FontSize="13" FontWeight="Bold" 
                       Cursor="Hand" Click="BackButton_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
