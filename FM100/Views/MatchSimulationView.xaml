<Window x:Class="FM100.Views.MatchSimulationView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Match Simulation" 
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2d2d2d" Padding="20" BorderBrush="#444444" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="HomeTeamText" Text="Home Team" 
                           FontSize="20" FontWeight="Bold" Foreground="#00d4ff" TextAlignment="Left"/>

                <TextBlock Grid.Column="1" x:Name="MatchDateText" Text="Week 1 - 2024" 
                           FontSize="14" Foreground="#888888" TextAlignment="Center" VerticalAlignment="Center" Margin="20,0"/>

                <TextBlock Grid.Column="2" x:Name="AwayTeamText" Text="Away Team" 
                           FontSize="20" FontWeight="Bold" Foreground="#4a9eff" TextAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Score Display -->
        <Border Grid.Row="1" Background="#2a2a2a" Padding="20" BorderBrush="#444444" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Home Score -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock x:Name="HomeScoreText" Text="0" FontSize="72" FontWeight="Bold" 
                               Foreground="#00d4ff" TextAlignment="Center"/>
                    <TextBlock FontSize="12" Foreground="#888888" TextAlignment="Center">
                        <Run Text="Shots: "/>
                        <Run x:Name="HomeShotsText" Text="0"/>
                    </TextBlock>
                </StackPanel>

                <!-- Time/Status -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40,0">
                    <TextBlock x:Name="MatchStatusText" Text="Match In Progress" 
                               FontSize="14" FontWeight="Bold" Foreground="#ffd700" TextAlignment="Center"/>
                    <TextBlock x:Name="MatchMinuteText" Text="45'" 
                               FontSize="28" FontWeight="Bold" Foreground="#00d4ff" TextAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Away Score -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock x:Name="AwayScoreText" Text="0" FontSize="72" FontWeight="Bold" 
                               Foreground="#4a9eff" TextAlignment="Center"/>
                    <TextBlock FontSize="12" Foreground="#888888" TextAlignment="Center">
                        <Run Text="Shots: "/>
                        <Run x:Name="AwayShotsText" Text="0"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Match Events Log -->
        <Border Grid.Row="2" Background="#2a2a2a" BorderBrush="#444444" BorderThickness="1" Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#2d2d2d" Padding="15">
                    <TextBlock Text="📋 Match Events" FontSize="14" FontWeight="Bold" Foreground="#ffd700"/>
                </Border>

                <ListBox Grid.Row="1" x:Name="EventsListBox" Background="#1e1e1e" 
                         Foreground="White" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1e1e1e" Padding="12" BorderBrush="#333333" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" x:Name="EventMinuteText" Text="{Binding Minute}" 
                                               FontSize="11" FontWeight="Bold" Foreground="#ffd700" Width="40"/>

                                    <TextBlock Grid.Column="1" Text="{Binding Description}" 
                                               FontSize="12" Foreground="White" Margin="10,0,0,0" TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Control Buttons -->
        <Border Grid.Row="3" Background="#2d2d2d" Padding="15" BorderBrush="#444444" BorderThickness="1,1,1,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="PlayButton" Content="▶ PLAY MATCH" Height="40" Width="150" 
                        FontSize="12" FontWeight="Bold" Background="#00d4ff" Foreground="#000000" 
                        Cursor="Hand" Click="Play_Click" Margin="0,0,10,0"/>

                <Button x:Name="PauseButton" Content="⏸ PAUSE" Height="40" Width="100" 
                        FontSize="12" FontWeight="Bold" Background="#4a9eff" Foreground="White" 
                        Cursor="Hand" Click="Pause_Click" Margin="0,0,10,0" IsEnabled="False"/>

                <Button x:Name="SkipButton" Content="⏭ SKIP TO END" Height="40" Width="130" 
                        FontSize="12" FontWeight="Bold" Background="#666666" Foreground="White" 
                        Cursor="Hand" Click="SkipToEnd_Click" Margin="0,0,10,0"/>

                <Button x:Name="DoneButton" Content="✓ DONE" Height="40" Width="100" 
                        FontSize="12" FontWeight="Bold" Background="#228b22" Foreground="White" 
                        Cursor="Hand" Click="Done_Click" IsEnabled="False"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
