<Window x:Class="FM100.Views.SaveGameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save Game" 
        Height="300" 
        Width="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PrimaryBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="Segoe UI"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow">

    <Grid Margin="{StaticResource LargeMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" 
                   Text="Save Your Game" 
                   FontSize="{StaticResource SubtitleFontSize}" 
                   FontWeight="Bold"
                   Foreground="{StaticResource AccentBrush}"
                   Margin="0,0,0,20"/>

        <!-- Save Name Label -->
        <TextBlock Grid.Row="1" 
                   Text="Save Name:" 
                   FontSize="{StaticResource NormalFontSize}"
                   Margin="0,0,0,5"/>

        <!-- Save Name Input -->
        <TextBox x:Name="SaveNameTextBox"
                 Grid.Row="2"
                 Height="40"
                 Padding="10"
                 FontSize="{StaticResource NormalFontSize}"
                 Background="#2d2d2d"
                 Foreground="{StaticResource PrimaryTextBrush}"
                 BorderBrush="{StaticResource AccentBrush}"
                 BorderThickness="1"
                 Margin="0,0,0,20"/>

        <!-- Timestamp Display -->
        <StackPanel Grid.Row="3" Margin="0,0,0,20">
            <TextBlock Text="Save Date:" 
                       FontSize="{StaticResource NormalFontSize}"
                       Margin="0,0,0,5"/>
            <TextBlock x:Name="TimestampTextBlock" 
                       Text="Loading..." 
                       FontSize="{StaticResource SmallFontSize}"
                       Foreground="{StaticResource SecondaryTextBrush}"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button x:Name="SaveButton"
                    Content="Save"
                    Width="100"
                    Height="40"
                    Margin="0,0,10,0"
                    Background="{StaticResource AccentBrush}"
                    Foreground="{StaticResource BlackBrush}"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Click="SaveButton_Click"/>
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Width="100"
                    Height="40"
                    Background="#3a3a3a"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    BorderBrush="{StaticResource SecondaryTextBrush}"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
