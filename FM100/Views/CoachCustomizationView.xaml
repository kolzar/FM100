<UserControl x:Class="FM100.Views.CoachCustomizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#1a1a2e"
             Foreground="White">
    <Grid>
        <!-- Background -->
        <Rectangle Fill="#000000" Opacity="0.3"/>

        <!-- Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40">

                <!-- Header -->
                <TextBlock Text="Personalizza il Tuo Allenatore" 
                           FontSize="32" 
                           FontWeight="Bold" 
                           Foreground="#00d4ff" 
                           Margin="0,0,0,30"/>

                <!-- Coach Name -->
                <TextBlock Text="Nome Allenatore" 
                           FontSize="14" 
                           Foreground="#B0B0B0" 
                           Margin="0,0,0,5"/>
                <TextBox x:Name="CoachNameInput"
                         Height="45"
                         Padding="15"
                         FontSize="14"
                         Background="#2a2a4e"
                         Foreground="White"
                         BorderBrush="#00d4ff"
                         BorderThickness="2"
                         Margin="0,0,0,20"/>

                <!-- Coach Nationality -->
                <TextBlock Text="Nazionalità" 
                           FontSize="14" 
                           Foreground="#B0B0B0" 
                           Margin="0,0,0,5"/>
                <ComboBox x:Name="CoachNationalityInput"
                          Height="45"
                          Padding="15"
                          FontSize="14"
                          Background="#2a2a4e"
                          Foreground="White"
                          BorderBrush="#00d4ff"
                          BorderThickness="2"
                          Margin="0,0,0,20">
                    <ComboBoxItem>Italia</ComboBoxItem>
                    <ComboBoxItem>Spagna</ComboBoxItem>
                    <ComboBoxItem>Inghilterra</ComboBoxItem>
                    <ComboBoxItem>Germania</ComboBoxItem>
                    <ComboBoxItem>Francia</ComboBoxItem>
                    <ComboBoxItem>Portogallo</ComboBoxItem>
                    <ComboBoxItem>Olanda</ComboBoxItem>
                    <ComboBoxItem>Belgio</ComboBoxItem>
                    <ComboBoxItem>Altro</ComboBoxItem>
                </ComboBox>

                <!-- Coach Age -->
                <TextBlock Text="Età" 
                           FontSize="14" 
                           Foreground="#B0B0B0" 
                           Margin="0,0,0,5"/>
                <Slider x:Name="CoachAgeSlider"
                        Minimum="25"
                        Maximum="70"
                        Value="45"
                        Height="30"
                        TickPlacement="BottomRight"
                        TickFrequency="5"
                        Margin="0,0,0,10"
                        Foreground="#00d4ff"/>
                <TextBlock x:Name="CoachAgeDisplay" 
                           Text="45 anni" 
                           FontSize="12" 
                           Foreground="#888888" 
                           Margin="0,0,0,20"/>

                <!-- Tactical Style -->
                <TextBlock Text="Stile Tattico Preferito" 
                           FontSize="14" 
                           Foreground="#B0B0B0" 
                           Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <RadioButton x:Name="AttackingStyle"
                                 Content="🔴 Offensivo"
                                 Foreground="White"
                                 Margin="0,0,20,0"
                                 FontSize="12"/>
                    <RadioButton x:Name="BalancedStyle"
                                 Content="🟡 Equilibrato"
                                 Foreground="White"
                                 Margin="0,0,20,0"
                                 FontSize="12"
                                 IsChecked="True"/>
                    <RadioButton x:Name="DefensiveStyle"
                                 Content="🔵 Difensivo"
                                 Foreground="White"
                                 FontSize="12"/>
                </StackPanel>

                <!-- Separator -->
                <Rectangle Height="1" Fill="#3a3a6e" Margin="0,20,0,20"/>

                <!-- Team Selection Header -->
                <TextBlock Text="Scegli la Tua Squadra" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="#00d4ff" 
                           Margin="0,0,0,20"/>

                <!-- Division Selection -->
                <TextBlock Text="Seleziona la Divisione" 
                           FontSize="14" 
                           Foreground="#B0B0B0" 
                           Margin="0,0,0,5"/>
                <ComboBox x:Name="DivisionSelection"
                          Height="45"
                          Padding="15"
                          FontSize="14"
                          Background="#2a2a4e"
                          Foreground="White"
                          BorderBrush="#00d4ff"
                          BorderThickness="2"
                          Margin="0,0,0,20">
                    <ComboBoxItem>Serie A (Divisione 1)</ComboBoxItem>
                    <ComboBoxItem>Serie B (Divisione 2)</ComboBoxItem>
                    <ComboBoxItem>Serie C (Divisione 3)</ComboBoxItem>
                </ComboBox>

                <!-- Team List -->
                <TextBlock Text="Disponibili:" 
                           FontSize="12" 
                           Foreground="#B0B0B0" 
                           Margin="0,0,0,10"/>
                <ListBox x:Name="TeamList"
                         Height="250"
                         Background="#2a2a4e"
                         Foreground="White"
                         BorderBrush="#00d4ff"
                         BorderThickness="2"
                         Margin="0,0,0,20">
                    <!-- Teams will be populated dynamically -->
                </ListBox>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="CancelButton"
                            Content="Indietro" 
                            Width="120" 
                            Height="45" 
                            FontSize="14"
                            Margin="0,0,10,0"
                            Background="#3a3a6e"
                            Foreground="White"
                            BorderBrush="#888888"
                            BorderThickness="2"/>

                    <Button x:Name="ContinueButton"
                            Content="Continua" 
                            Width="120" 
                            Height="45" 
                            FontSize="14"
                            Background="#00d4ff"
                            Foreground="Black"
                            FontWeight="SemiBold"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
