<UserControl x:Class="FM100.Views.GameDashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="800" Width="1200"
        Background="#0a0e27"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR - BUTTONS -->
        <Border Grid.Column="0" Background="#1a1f3a" BorderBrush="#2d3561" BorderThickness="0,0,1,0">
            <StackPanel Margin="0" VerticalAlignment="Top">
                <Button x:Name="DashboardButton" Content="📊 DASHBOARD" Height="50" Foreground="White" Background="#00d4ff" FontSize="12" FontWeight="Bold" Cursor="Hand" Click="DashboardBtn_Click" Margin="0"/>
                <Button x:Name="StandingsButton" Content="🏆 STANDINGS" Height="50" Foreground="White" Background="#4a9eff" FontSize="12" FontWeight="Bold" Cursor="Hand" Click="StandingsBtn_Click" Margin="0"/>
                <Button x:Name="FixturesButton" Content="📅 FIXTURES" Height="50" Foreground="White" Background="#4a9eff" FontSize="12" FontWeight="Bold" Cursor="Hand" Click="FixturesBtn_Click" Margin="0"/>
                <Button x:Name="ResultsButton" Content="✅ RESULTS" Height="50" Foreground="White" Background="#4a9eff" FontSize="12" FontWeight="Bold" Cursor="Hand" Click="ResultsBtn_Click" Margin="0"/>
                <Button x:Name="SquadButton" Content="👥 SQUAD" Height="50" Foreground="White" Background="#4a9eff" FontSize="12" FontWeight="Bold" Cursor="Hand" Click="SquadBtn_Click" Margin="0"/>
                <Button x:Name="SaveButton" Content="💾 SAVE" Height="50" Foreground="White" Background="#666666" FontSize="12" FontWeight="Bold" Cursor="Hand" Click="Save_Click" Margin="0"/>
                <Button x:Name="MenuButton" Content="🏠 MENU" Height="50" Foreground="White" Background="#cc3333" FontSize="12" FontWeight="Bold" Cursor="Hand" Click="Menu_Click" Margin="0"/>
            </StackPanel>
        </Border>

        <!-- RIGHT CONTENT -->
        <Border Grid.Column="1" Background="#0a0e27">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <!-- DASHBOARD CONTENT -->
                    <Border x:Name="DashboardContent" Visibility="Visible" Background="#1a1f3a" Padding="20" CornerRadius="5" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="GAME DASHBOARD" FontSize="20" FontWeight="Bold" Foreground="#00d4ff" Margin="0,0,0,15"/>
                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="#ffffff" Margin="0,0,0,5">
                                <Run Text="Club: "/>
                                <Run x:Name="ClubNameText" Text="Your Club" Foreground="#00d4ff"/>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="#b0b0b0" Margin="0,0,0,10">
                                <Run Text="Season: "/>
                                <Run x:Name="SeasonText" Text="1" Foreground="#ffffff"/>
                                <Run Text=" | Position: "/>
                                <Run x:Name="PositionText" Text="--" Foreground="#ffffff"/>
                                <Run Text=" | Points: "/>
                                <Run x:Name="PointsText" Text="0" Foreground="#ffffff"/>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="#b0b0b0" Margin="0,0,0,10">
                                <Run Text="Record: "/>
                                <Run x:Name="RecordText" Text="0-0-0" Foreground="#ffffff"/>
                                <Run Text=" | Goal Difference: "/>
                                <Run x:Name="GoalDiffText" Text="0" Foreground="#ffffff"/>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="#b0b0b0" Margin="0,0,0,10">
                                <Run Text="Morale: "/>
                                <Run x:Name="MoraleText" Text="75%" Foreground="#00ff00"/>
                                <Run Text=" | Budget: €"/>
                                <Run x:Name="BudgetText" Text="0" Foreground="#ffff00"/>
                                <Run Text="M"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- STANDINGS CONTENT -->
                    <Border x:Name="StandingsContent" Visibility="Collapsed" Background="#1a1f3a" Padding="20" CornerRadius="5" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="LEAGUE STANDINGS" FontSize="16" FontWeight="Bold" Foreground="#00d4ff" Margin="0,0,0,15"/>
                            <ListBox x:Name="StandingsList" Background="#0a0e27" Foreground="#ffffff" Height="400" BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <!-- FIXTURES CONTENT -->
                    <Border x:Name="FixturesContent" Visibility="Collapsed" Background="#1a1f3a" Padding="20" CornerRadius="5" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="UPCOMING FIXTURES" FontSize="16" FontWeight="Bold" Foreground="#00d4ff" Margin="0,0,0,15"/>
                            <ListBox x:Name="FixturesList" Background="#0a0e27" Foreground="#ffffff" Height="400" BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <!-- RESULTS CONTENT -->
                    <Border x:Name="ResultsContent" Visibility="Collapsed" Background="#1a1f3a" Padding="20" CornerRadius="5" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="RECENT RESULTS" FontSize="16" FontWeight="Bold" Foreground="#00d4ff" Margin="0,0,0,15"/>
                            <ListBox x:Name="ResultsList" Background="#0a0e27" Foreground="#ffffff" Height="400" BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <!-- SQUAD CONTENT -->
                    <Border x:Name="SquadContent" Visibility="Collapsed" Background="#1a1f3a" Padding="20" CornerRadius="5" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="YOUR SQUAD" FontSize="16" FontWeight="Bold" Foreground="#00d4ff" Margin="0,0,0,15"/>
                            <TextBlock Text="Squad management coming soon!" Foreground="#b0b0b0"/>
                        </StackPanel>
                    </Border>

                    <!-- TIPS -->
                    <Border Background="#2a2f4a" Padding="15" CornerRadius="5">
                        <TextBlock Text="💡 Tip: Click buttons on the left to navigate!" Foreground="#b0b0b0" FontSize="11" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
