                            <TextBlock Text="CONTRACT HISTORY" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                            <ListBox x:Name="ContractHistoryList" Background="{DynamicResource PrimaryBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" Height="160" BorderThickness="0" Margin="0,0,0,14">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="280"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding EventText}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding PlayerText}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Summary}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="DRESSING ROOM HISTORY" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                            <ListBox x:Name="TeamTalkHistoryList" Background="{DynamicResource PrimaryBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" Height="180" BorderThickness="0" Margin="0,0,0,14">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding PeriodText}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TalkText}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="2" Text="{Binding ImpactText}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding TrustText}" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="STAFF HISTORY" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                            <ListBox x:Name="StaffHistoryList" Background="{DynamicResource PrimaryBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" Height="180" BorderThickness="0" Margin="0,0,0,14">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="330"/>
                                                <ColumnDefinition Width="210"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding PeriodText}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding QualityText}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="2" Text="{Binding ContractText}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Summary}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="WORLD FINANCE" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                            <ListBox x:Name="ClubFinanceHistoryList" Background="{DynamicResource PrimaryBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" Height="190" BorderThickness="0" Margin="0,0,0,14">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="190"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="220"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding PeriodText}" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ClubName}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Breakdown}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding ResultText}" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="FINANCE HISTORY" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                            <ListBox x:Name="FinanceHistoryList" Background="{DynamicResource PrimaryBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" Height="150" BorderThickness="0" Margin="0,0,0,14">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding PeriodText}" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding AmountText}" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Description}" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="ACHIEVEMENT ARCHIVE" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                            <ListBox x:Name="AchievementHistoryList" Background="{DynamicResource PrimaryBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" Height="120" BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <!-- TIPS -->
                    <Border Background="{DynamicResource TertiaryBackgroundBrush}" Padding="15" CornerRadius="5">
                        <TextBlock Text="💡 Tip: Click buttons on the left to navigate!" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
