<UserControl x:Class="FM100.Views.GameDashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource PrimaryBackgroundBrush}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR - BUTTONS -->
        <Border Grid.Column="0" Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="0" VerticalAlignment="Top">
                <Button x:Name="DashboardButton" Content="📊 DASHBOARD" Height="50" Foreground="{DynamicResource InverseTextBrush}" Background="{DynamicResource AccentBrush}" FontSize="12" FontWeight="Bold" Cursor="Hand" Click="DashboardBtn_Click" Margin="0"/>
                <Button x:Name="StandingsButton" Content="🏆 STANDINGS" Height="50" Foreground="{DynamicResource PrimaryTextBrush}" Background="{DynamicResource TertiaryBackgroundBrush}" FontSize="12" FontWeight="Bold" Cursor="Hand" Click="StandingsBtn_Click" Margin="0"/>
                <Button x:Name="FixturesButton" Content="📅 FIXTURES" Height="50" Foreground="{DynamicResource PrimaryTextBrush}" Background="{DynamicResource TertiaryBackgroundBrush}" FontSize="12" FontWeight="Bold" Cursor="Hand" Click="FixturesBtn_Click" Margin="0"/>
                <Button x:Name="ResultsButton" Content="✅ RESULTS" Height="50" Foreground="{DynamicResource PrimaryTextBrush}" Background="{DynamicResource TertiaryBackgroundBrush}" FontSize="12" FontWeight="Bold" Cursor="Hand" Click="ResultsBtn_Click" Margin="0"/>
                <Button x:Name="SquadButton" Content="👥 SQUAD" Height="50" Foreground="{DynamicResource PrimaryTextBrush}" Background="{DynamicResource TertiaryBackgroundBrush}" FontSize="12" FontWeight="Bold" Cursor="Hand" Click="SquadBtn_Click" Margin="0"/>
                <Button x:Name="TransfersButton" Content="💼 TRANSFERS" Height="50" Foreground="{DynamicResource PrimaryTextBrush}" Background="{DynamicResource TertiaryBackgroundBrush}" FontSize="12" FontWeight="Bold" Cursor="Hand" Click="TransfersBtn_Click" Margin="0"/>
                <Button x:Name="HistoryButton" Content="📜 HISTORY" Height="50" Foreground="{DynamicResource PrimaryTextBrush}" Background="{DynamicResource TertiaryBackgroundBrush}" FontSize="12" FontWeight="Bold" Cursor="Hand" Click="HistoryBtn_Click" Margin="0"/>
                <Button x:Name="SaveButton" Content="💾 SAVE" Height="50" Foreground="{DynamicResource PrimaryTextBrush}" Background="{DynamicResource InputBackgroundBrush}" FontSize="12" FontWeight="Bold" Cursor="Hand" Click="Save_Click" Margin="0"/>
                <Button x:Name="MenuButton" Content="🏠 MENU" Height="50" Foreground="{DynamicResource InverseTextBrush}" Background="{DynamicResource DangerBrush}" FontSize="12" FontWeight="Bold" Cursor="Hand" Click="Menu_Click" Margin="0"/>
            </StackPanel>
        </Border>

        <!-- RIGHT CONTENT -->
        <Border Grid.Column="1" Background="{DynamicResource PrimaryBackgroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <!-- DASHBOARD CONTENT -->
                    <Border x:Name="DashboardContent" Visibility="Visible" Background="{DynamicResource PanelBackgroundBrush}" Padding="20" CornerRadius="5" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="GAME DASHBOARD" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,15"/>
                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,5">
                                <Run Text="Club: "/>
                                <Run x:Name="ClubNameText" Text="Your Club" Foreground="{DynamicResource AccentBrush}"/>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10">
                                <Run Text="Season: "/>
                                <Run x:Name="SeasonText" Text="1" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <Run Text=" | Day: "/>
                                <Run x:Name="DayText" Text="0" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <Run Text=" | Position: "/>
                                <Run x:Name="PositionText" Text="--" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <Run Text=" | Points: "/>
                                <Run x:Name="PointsText" Text="0" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10">
                                <Run Text="Record: "/>
                                <Run x:Name="RecordText" Text="0-0-0" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <Run Text=" | Goal Difference: "/>
                                <Run x:Name="GoalDiffText" Text="0" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10">
                                <Run Text="Morale: "/>
                                <Run x:Name="MoraleText" Text="75%" Foreground="#00ff00"/>
                                <Run Text=" | Budget: €"/>
                                <Run x:Name="BudgetText" Text="0" Foreground="#ffff00"/>
                                <Run Text="M"/>
                            </TextBlock>

                            <Border Background="{DynamicResource TertiaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="15" CornerRadius="5" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="NEXT MATCH" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="NextMatchText" Text="No upcoming match" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock x:Name="NextMatchMetaText" Text="" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="NextMatchStrengthText" Text="" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="DashboardPlayButton" Content="PLAY MATCH" Height="40" Width="150" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource InverseTextBrush}" Background="{DynamicResource SuccessBrush}" FontSize="12" FontWeight="Bold" Cursor="Hand" Click="PlayFixture_Click"/>
                                    <Button Grid.Column="2" Content="REST DAY" Height="40" Width="100" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Background="{DynamicResource InputBackgroundBrush}" FontSize="12" FontWeight="Bold" Cursor="Hand" Click="RestDay_Click"/>
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource TertiaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="15" CornerRadius="5" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="TEAM TALK" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="TeamTalkSummaryText" Text="Morale -- | Motivation --" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="CALM" Height="34" Tag="Calm" Click="TeamTalk_Click" Foreground="{DynamicResource PrimaryTextBrush}" Background="{DynamicResource InputBackgroundBrush}" FontSize="11" FontWeight="Bold" Cursor="Hand" Margin="6,0"/>
                                    <Button Grid.Column="2" Content="BALANCED" Height="34" Tag="Balanced" Click="TeamTalk_Click" Foreground="{DynamicResource InverseTextBrush}" Background="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" Cursor="Hand" Margin="6,0"/>
                                    <Button Grid.Column="3" Content="FIRE UP" Height="34" Tag="FireUp" Click="TeamTalk_Click" Foreground="{DynamicResource InverseTextBrush}" Background="{DynamicResource SuccessBrush}" FontSize="11" FontWeight="Bold" Cursor="Hand" Margin="6,0,0,0"/>
                                </Grid>
                            </Border>

                            <Border x:Name="MediaEventPanel" Background="{DynamicResource TertiaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="15" CornerRadius="5" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="MEDIA" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="MediaHeadlineText" Text="No media questions" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock x:Name="MediaQuestionText" Text="" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                    <TextBlock x:Name="MediaOutcomeText" Text="" FontSize="12" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" x:Name="ProtectSquadMediaButton" Content="PROTECT SQUAD" Height="34" Tag="ProtectSquad" Click="MediaResponse_Click" Foreground="{DynamicResource InverseTextBrush}" Background="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" Cursor="Hand" Margin="0,0,6,0"/>
                                        <Button Grid.Column="1" x:Name="ChallengeSquadMediaButton" Content="CHALLENGE" Height="34" Tag="ChallengeSquad" Click="MediaResponse_Click" Foreground="{DynamicResource InverseTextBrush}" Background="{DynamicResource SuccessBrush}" FontSize="11" FontWeight="Bold" Cursor="Hand" Margin="6,0"/>
                                        <Button Grid.Column="2" x:Name="DeflectPressureMediaButton" Content="DEFLECT" Height="34" Tag="DeflectPressure" Click="MediaResponse_Click" Foreground="{DynamicResource PrimaryTextBrush}" Background="{DynamicResource InputBackgroundBrush}" FontSize="11" FontWeight="Bold" Cursor="Hand" Margin="6,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="SEASON SNAPSHOT" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,16,0,6"/>
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource TertiaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" CornerRadius="5" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="PLAYED" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="Bold"/>
                                        <TextBlock x:Name="SeasonPlayedText" Text="0" FontSize="16" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{DynamicResource TertiaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" CornerRadius="5" Margin="6,0">
                                    <StackPanel>
                                        <TextBlock Text="REMAINING" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="Bold"/>
                                        <TextBlock x:Name="SeasonRemainingText" Text="0" FontSize="16" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{DynamicResource TertiaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" CornerRadius="5" Margin="6,0">
                                    <StackPanel>
                                        <TextBlock Text="WIN RATE" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="Bold"/>
                                        <TextBlock x:Name="WinRateText" Text="0%" FontSize="16" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Background="{DynamicResource TertiaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" CornerRadius="5" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="FORM" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="Bold"/>
                                        <TextBlock x:Name="SeasonFormText" Text="-" FontSize="16" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Text="ACHIEVEMENTS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,16,0,6"/>
                            <ListBox x:Name="AchievementsList" Background="{DynamicResource PrimaryBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" Height="90" BorderThickness="0"/>

                            <TextBlock Text="HISTORICAL STATS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,16,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource TertiaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" CornerRadius="5" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="MATCHES" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="Bold"/>
                                        <TextBlock x:Name="HistoryMatchesText" Text="0" FontSize="16" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{DynamicResource TertiaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" CornerRadius="5" Margin="6,0">
                                    <StackPanel>
                                        <TextBlock Text="GOALS" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="Bold"/>
                                        <TextBlock x:Name="HistoryGoalsText" Text="0-0" FontSize="16" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{DynamicResource TertiaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" CornerRadius="5" Margin="6,0">
                                    <StackPanel>
                                        <TextBlock Text="POINTS/MATCH" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="Bold"/>
                                        <TextBlock x:Name="HistoryPointsText" Text="0.00" FontSize="16" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Background="{DynamicResource TertiaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" CornerRadius="5" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="CLEAN SHEETS" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="Bold"/>
                                        <TextBlock x:Name="HistoryCleanSheetsText" Text="0" FontSize="16" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Text="RECENT RESULTS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,16,0,6"/>
                            <ListBox x:Name="DashboardResultsList" Background="{DynamicResource PrimaryBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" Height="150" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding WeekText}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding MatchText}" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Score}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Button Grid.Column="3" Content="DETAILS" Height="28" Tag="{Binding MatchId}" IsEnabled="{Binding HasMatchDetails}" Click="ViewMatchDetails_Click" Foreground="{DynamicResource InverseTextBrush}" Background="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- STANDINGS CONTENT -->
                    <Border x:Name="StandingsContent" Visibility="Collapsed" Background="{DynamicResource PanelBackgroundBrush}" Padding="20" CornerRadius="5" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="LEAGUE STANDINGS" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,15"/>
                            <Grid Margin="4,0,4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="POS" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="CLUB" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Grid.Column="2" Text="PTS" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Grid.Column="3" Text="P" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Grid.Column="4" Text="W" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Grid.Column="5" Text="D" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Grid.Column="6" Text="L" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Grid.Column="7" Text="GF" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Grid.Column="8" Text="GA" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Grid.Column="9" Text="GD" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Grid.Column="10" Text="FORM" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" FontWeight="Bold"/>
                            </Grid>
                            <ListBox x:Name="StandingsList" Background="{DynamicResource PrimaryBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" Height="400" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Position}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ClubName}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Points}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Played}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Wins}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <TextBlock Grid.Column="5" Text="{Binding Draws}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <TextBlock Grid.Column="6" Text="{Binding Losses}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <TextBlock Grid.Column="7" Text="{Binding GoalsFor}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <TextBlock Grid.Column="8" Text="{Binding GoalsAgainst}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <TextBlock Grid.Column="9" Text="{Binding GoalDifferenceText}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <TextBlock Grid.Column="10" Text="{Binding Form}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- FIXTURES CONTENT -->
                    <Border x:Name="FixturesContent" Visibility="Collapsed" Background="{DynamicResource PanelBackgroundBrush}" Padding="20" CornerRadius="5" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="UPCOMING FIXTURES" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,15"/>
                            <Button Content="PLAY NEXT MATCH" Height="40" Width="180" HorizontalAlignment="Left" Foreground="{DynamicResource InverseTextBrush}" Background="{DynamicResource SuccessBrush}" FontSize="12" FontWeight="Bold" Cursor="Hand" Click="PlayFixture_Click" Margin="0,0,0,15"/>
                            <ListBox x:Name="FixturesList" Background="{DynamicResource PrimaryBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" Height="400" BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <!-- RESULTS CONTENT -->
                    <Border x:Name="ResultsContent" Visibility="Collapsed" Background="{DynamicResource PanelBackgroundBrush}" Padding="20" CornerRadius="5" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="RECENT RESULTS" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,15"/>
                            <ListBox x:Name="ResultsList" Background="{DynamicResource PrimaryBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" Height="260" BorderThickness="0" Margin="0,0,0,15">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding WeekText}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Date}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding MatchText}" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Score}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Button Grid.Column="4" Content="DETAILS" Height="28" Tag="{Binding MatchId}" IsEnabled="{Binding HasMatchDetails}" Click="ViewMatchDetails_Click" Foreground="{DynamicResource InverseTextBrush}" Background="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border x:Name="MatchDetailContent" Visibility="Collapsed" Background="{DynamicResource TertiaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="15" CornerRadius="5">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="MatchDetailTitle" Text="MATCH DETAILS" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock x:Name="MatchDetailScore" Text="" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="CLOSE" Width="80" Height="28" Click="CloseMatchDetails_Click" Foreground="{DynamicResource PrimaryTextBrush}" Background="{DynamicResource InputBackgroundBrush}" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                                    </Grid>

                                    <TextBlock Text="STATISTICS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                    <ListBox x:Name="MatchStatisticsList" Background="{DynamicResource PrimaryBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" Height="110" BorderThickness="0" Margin="0,0,0,12"/>

                                    <TextBlock Text="TIMELINE" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                    <ListBox x:Name="MatchEventsList" Background="{DynamicResource PrimaryBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" Height="160" BorderThickness="0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- TRANSFERS CONTENT -->
                    <Border x:Name="TransfersContent" Visibility="Collapsed" Background="{DynamicResource PanelBackgroundBrush}" Padding="20" CornerRadius="5" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="TRANSFER MARKET" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,15"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="TransferMarketSummaryText" Text="No players currently available" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock Text="Scout the market, compare cost and contract demand, then sign players directly into the squad." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="TransferBudgetText" Text="Budget EUR 0M" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                            </Grid>

                            <ListBox x:Name="TransferMarketList" Background="{DynamicResource PrimaryBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" Height="420" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="84"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding PriceText}" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding WageText}" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding ContractText}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding StatusText}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="5" Content="SIGN" Height="28" Tag="{Binding ListingId}" IsEnabled="{Binding CanSign}" Click="SignTransfer_Click" Foreground="{DynamicResource InverseTextBrush}" Background="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" Cursor="Hand" Margin="4,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- SQUAD CONTENT -->
                    <Border x:Name="SquadContent" Visibility="Collapsed" Background="{DynamicResource PanelBackgroundBrush}" Padding="20" CornerRadius="5" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="YOUR SQUAD" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,15"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="SquadSummaryText" Text="0 players" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock x:Name="SquadMoodText" Text="Morale -- | Value --" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="FORMATION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="FormationComboBox" Height="34" SelectionChanged="FormationComboBox_SelectionChanged" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
                                        <ComboBoxItem Content="4-3-3"/>
                                        <ComboBoxItem Content="4-4-2"/>
                                        <ComboBoxItem Content="3-5-2"/>
                                        <ComboBoxItem Content="4-2-3-1"/>
                                        <ComboBoxItem Content="5-3-2"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="MENTALITY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="MentalityComboBox" Height="34" SelectionChanged="TacticalInstruction_SelectionChanged" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
                                        <ComboBoxItem Content="Balanced"/>
                                        <ComboBoxItem Content="Attacking"/>
                                        <ComboBoxItem Content="Defensive"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0">
                                    <TextBlock Text="PRESSING" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="PressingComboBox" Height="34" SelectionChanged="TacticalInstruction_SelectionChanged" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
                                        <ComboBoxItem Content="Low"/>
                                        <ComboBoxItem Content="Medium"/>
                                        <ComboBoxItem Content="High"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                    <TextBlock Text="TEMPO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="TempoComboBox" Height="34" SelectionChanged="TacticalInstruction_SelectionChanged" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
                                        <ComboBoxItem Content="Slow"/>
                                        <ComboBoxItem Content="Normal"/>
                                        <ComboBoxItem Content="Fast"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="STARTING XI" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                    <ListBox x:Name="StartingLineupList" Background="{DynamicResource PrimaryBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" Height="180" BorderThickness="0" AllowDrop="True" PreviewMouseMove="LineupList_PreviewMouseMove" Drop="StartingLineupList_Drop">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayText}" Margin="4"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="BENCH" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                    <ListBox x:Name="BenchList" Background="{DynamicResource PrimaryBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" Height="180" BorderThickness="0" AllowDrop="True" PreviewMouseMove="LineupList_PreviewMouseMove" Drop="BenchList_Drop">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayText}" Margin="4"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="PLAYER STATUS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource TertiaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12" CornerRadius="5" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="MOST USED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock x:Name="MostUsedPlayerText" Text="-" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{DynamicResource TertiaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12" CornerRadius="5" Margin="6,0">
                                    <StackPanel>
                                        <TextBlock Text="FATIGUE RISK" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock x:Name="FatigueRiskText" Text="-" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{DynamicResource TertiaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12" CornerRadius="5" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="LOW MORALE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock x:Name="LowMoraleText" Text="-" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Background="{DynamicResource TertiaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12" CornerRadius="5" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="INJURIES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock x:Name="InjuryStatusText" Text="-" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Text="FULL ROSTER" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                            <ListBox x:Name="SquadList" Background="{DynamicResource PrimaryBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" Height="420" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="84"/>
                                                <ColumnDefinition Width="84"/>
                                                <ColumnDefinition Width="84"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Number}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding AgeText}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding ReputationText}" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding MoraleText}" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{Binding ValueText}" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="6" Text="{Binding LoadText}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="7" Text="{Binding ContractText}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="8" Content="START" Height="28" Tag="{Binding PlayerId}" Click="MovePlayerToStarting_Click" Foreground="{DynamicResource InverseTextBrush}" Background="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" Cursor="Hand" Margin="4,0"/>
                                            <Button Grid.Column="9" Content="BENCH" Height="28" Tag="{Binding PlayerId}" Click="MovePlayerToBench_Click" Foreground="{DynamicResource PrimaryTextBrush}" Background="{DynamicResource InputBackgroundBrush}" FontSize="11" FontWeight="Bold" Cursor="Hand" Margin="4,0"/>
                                            <Button Grid.Column="10" Content="RENEW" Height="28" Tag="{Binding PlayerId}" IsEnabled="{Binding CanRenew}" Click="RenewContract_Click" Foreground="{DynamicResource InverseTextBrush}" Background="{DynamicResource SuccessBrush}" FontSize="11" FontWeight="Bold" Cursor="Hand" Margin="4,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- HISTORY CONTENT -->
                    <Border x:Name="HistoryContent" Visibility="Collapsed" Background="{DynamicResource PanelBackgroundBrush}" Padding="20" CornerRadius="5" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="HISTORY" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,15"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="HALL OF FAME" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                    <ListBox x:Name="TitleHistoryList" Background="{DynamicResource PrimaryBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" Height="360" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="70"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding ClubName}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DivisionText}" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding TitlesText}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="MEDIA ARCHIVE" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                    <ListBox x:Name="MediaHistoryList" Background="{DynamicResource PrimaryBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" Height="360" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="4,6">
                                                    <TextBlock Text="{Binding Headline}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding MetaText}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding Outcome}" Foreground="{DynamicResource AccentBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="ACHIEVEMENT ARCHIVE" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                            <ListBox x:Name="AchievementHistoryList" Background="{DynamicResource PrimaryBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" Height="160" BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <!-- TIPS -->
                    <Border Background="{DynamicResource TertiaryBackgroundBrush}" Padding="15" CornerRadius="5">
                        <TextBlock Text="💡 Tip: Click buttons on the left to navigate!" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
