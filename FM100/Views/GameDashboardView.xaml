<Window x:Class="FM100.Views.GameDashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Dashboard" 
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Season & Club Info -->
        <Border Grid.Row="0" Background="#2d2d2d" BorderBrush="#444444" BorderThickness="0,0,0,1">
            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Club & Season Info -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="ClubNameText" Text="Your Club" FontSize="24" FontWeight="Bold" Foreground="#00d4ff"/>
                    <TextBlock FontSize="12" Foreground="#888888">
                        <Run Text="Season "/>
                        <Run x:Name="SeasonText" Text="1"/>
                        <Run Text=" | League Position: "/>
                        <Run x:Name="PositionText" Text="--"/>
                        <Run Text=" | Points: "/>
                        <Run x:Name="PointsText" Text="0"/>
                    </TextBlock>
                </StackPanel>

                <!-- Quick Stats -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="30,0,0,0">
                    <TextBlock FontSize="11" Foreground="#888888">
                        <Run Text="W-D-L: "/>
                        <Run x:Name="RecordText" Text="0-0-0"/>
                        <Run Text=" | GD: "/>
                        <Run x:Name="GoalDiffText" Text="0"/>
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="#888888" Margin="0,3,0,0">
                        <Run Text="Morale: "/>
                        <Run x:Name="MoraleText" Text="75%"/>
                        <Run Text=" | Budget: €"/>
                        <Run x:Name="BudgetText" Text="0"/>
                        <Run Text="M"/>
                    </TextBlock>
                </StackPanel>

                <!-- Quick Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="💾 SAVE" Height="35" Width="80" FontSize="11" FontWeight="Bold" 
                            Background="#666666" Foreground="White" Cursor="Hand" Click="Save_Click" Margin="0,0,5,0"/>
                    <Button Content="⚙️ MENU" Height="35" Width="80" FontSize="11" FontWeight="Bold" 
                            Background="#666666" Foreground="White" Cursor="Hand" Click="Menu_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Fixtures & Standings -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Next Fixtures -->
                <Border Grid.Row="0" Background="#2a2a2a" BorderBrush="#444444" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#2d2d2d" Padding="15">
                            <TextBlock Text="📅 Upcoming Fixtures" FontSize="14" FontWeight="Bold" Foreground="#00d4ff"/>
                        </Border>

                        <ListBox Grid.Row="1" x:Name="FixturesListBox" Background="#2a2a2a" 
                                 Foreground="White" BorderThickness="0"
                                 ItemTemplate="{StaticResource FixtureItemTemplate}">
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Standings -->
                <Border Grid.Row="2" Background="#2a2a2a" BorderBrush="#444444" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#2d2d2d" Padding="15">
                            <TextBlock Text="🏆 League Standings (Top 5)" FontSize="14" FontWeight="Bold" Foreground="#ffd700"/>
                        </Border>

                        <DataGrid Grid.Row="1" x:Name="StandingsGrid" Background="#2a2a2a" 
                                  Foreground="White" BorderThickness="0"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                                  IsReadOnly="True" HeadersVisibility="Column">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#2d2d2d"/>
                                    <Setter Property="Foreground" Value="#888888"/>
                                    <Setter Property="BorderBrush" Value="#444444"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Pos" Binding="{Binding Position}" Width="40"/>
                                <DataGridTextColumn Header="Club" Binding="{Binding ClubName}" Width="*"/>
                                <DataGridTextColumn Header="Pts" Binding="{Binding Points}" Width="40"/>
                                <DataGridTextColumn Header="W-D-L" Binding="{Binding Record}" Width="60"/>
                                <DataGridTextColumn Header="GD" Binding="{Binding GoalDiff}" Width="50"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right: Quick Actions & Recent Results -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Action Buttons -->
                <Border Grid.Row="0" Background="#2a2a2a" BorderBrush="#444444" BorderThickness="1" Padding="15">
                    <StackPanel>
                        <Button Content="⚽ PLAY NEXT MATCH" Height="40" FontSize="12" FontWeight="Bold"
                                Background="#00d4ff" Foreground="#000000" Cursor="Hand" Click="PlayMatch_Click" Margin="0,0,0,8"/>

                        <Button Content="📋 VIEW SQUAD" Height="35" FontSize="11" FontWeight="Bold"
                                Background="#4a9eff" Foreground="White" Cursor="Hand" Click="ViewSquad_Click" Margin="0,0,0,8"/>

                        <Button Content="🎯 TACTICS" Height="35" FontSize="11" FontWeight="Bold"
                                Background="#4a9eff" Foreground="White" Cursor="Hand" Click="SetTactics_Click" Margin="0,0,0,8"/>

                        <Button Content="💰 FINANCES" Height="35" FontSize="11" FontWeight="Bold"
                                Background="#4a9eff" Foreground="White" Cursor="Hand" Click="ViewFinances_Click" Margin="0,0,0,8"/>

                        <Button Content="🔄 SKIP DAY" Height="35" FontSize="11" FontWeight="Bold"
                                Background="#666666" Foreground="White" Cursor="Hand" Click="SkipDay_Click"/>
                    </StackPanel>
                </Border>

                <!-- Recent Results -->
                <Border Grid.Row="2" Background="#2a2a2a" BorderBrush="#444444" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#2d2d2d" Padding="15">
                            <TextBlock Text="📊 Recent Results" FontSize="14" FontWeight="Bold" Foreground="#888888"/>
                        </Border>

                        <ListBox Grid.Row="1" x:Name="ResultsListBox" Background="#2a2a2a" 
                                 Foreground="White" BorderThickness="0"
                                 ItemTemplate="{StaticResource ResultItemTemplate}">
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#2d2d2d" Padding="15">
            <TextBlock Text="💡 Tip: Play matches to earn points and climb the league standings!" 
                       FontSize="11" Foreground="#666666" TextAlignment="Center"/>
        </Border>
    </Grid>

    <!-- Data Templates -->
    <Window.Resources>
        <!-- Fixture Template -->
        <DataTemplate x:Key="FixtureItemTemplate">
            <Border Background="#1e1e1e" Padding="12" BorderBrush="#333333" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="12" FontWeight="Bold" Foreground="#00d4ff">
                            <Run Text="{Binding HomeClubName}"/>
                            <Run Text=" vs "/>
                            <Run Text="{Binding AwayClubName}"/>
                        </TextBlock>
                        <TextBlock FontSize="10" Foreground="#888888" Margin="0,3,0,0">
                            <Run Text="Week "/>
                            <Run Text="{Binding MatchWeek}"/>
                            <Run Text=" • "/>
                            <Run Text="{Binding ScheduledDate, StringFormat=d}"/>
                        </TextBlock>
                    </StackPanel>

                    <Button Grid.Column="1" Content="PLAY" Height="28" Width="55" 
                            FontSize="10" FontWeight="Bold" Background="#00d4ff" Foreground="#000000"
                            Cursor="Hand" Click="PlayFixture_Click" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Result Template -->
        <DataTemplate x:Key="ResultItemTemplate">
            <Border Background="#1e1e1e" Padding="12" BorderBrush="#333333" BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="White">
                        <Run Text="{Binding HomeClubName}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding HomeGoals}" Foreground="#00d4ff" FontWeight="Bold"/>
                        <Run Text="-"/>
                        <Run Text="{Binding AwayGoals}" Foreground="#00d4ff" FontWeight="Bold"/>
                        <Run Text=" "/>
                        <Run Text="{Binding AwayClubName}"/>
                    </TextBlock>
                    <TextBlock FontSize="9" Foreground="#888888" Margin="0,2,0,0">
                        <Run Text="{Binding PlayedDate, StringFormat=g}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
</Window>
