<Window x:Class="FM100.Views.ClubSelectionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Your Club" 
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2d2d2d" Padding="20">
            <TextBlock Text="🏆 Choose Your Club" 
                       FontSize="32" 
                       FontWeight="Bold"
                       Foreground="#00d4ff"/>
        </Border>

        <!-- Difficulty Selection -->
        <Border Grid.Row="1" Background="#2a2a2a" Padding="20" HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Difficulty: " FontSize="14" Foreground="#aaaaaa" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="DifficultyCombo" Width="100" Height="30" Foreground="Black">
                    <ComboBoxItem Content="Easy" IsSelected="False"/>
                    <ComboBoxItem Content="Normal" IsSelected="True"/>
                    <ComboBoxItem Content="Hard" IsSelected="False"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- Division Tabs -->
        <TabControl Grid.Row="2" Padding="10" Background="#1e1e1e">
            <!-- Serie A Tab -->
            <TabItem Header="⭐ Serie A" Background="#2d2d2d" Foreground="#00d4ff">
                <Grid Background="#1e1e1e">
                    <ListBox x:Name="SerieAList" 
                             Background="#2a2a2a"
                             Foreground="White"
                             BorderBrush="#444444"
                             SelectedValuePath="Id">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1e1e1e" Padding="10" BorderBrush="#444444" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                                   Text="{Binding Abbreviation}" 
                                                   FontSize="16" 
                                                   FontWeight="Bold"
                                                   Foreground="#ffd700"
                                                   Width="50"
                                                   TextAlignment="Center"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                            <TextBlock Text="{Binding City}" FontSize="11" Foreground="#888888"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="15,0,0,0">
                                            <TextBlock FontSize="10" Foreground="#888888">
                                                <Run Text="💰 "/>
                                                <Run Text="{Binding BudgetInMillions}"/>
                                                <Run Text=" M"/>
                                            </TextBlock>
                                            <TextBlock FontSize="10" Foreground="#888888">
                                                <Run Text="⭐ "/>
                                                <Run Text="{Binding Reputation}"/>
                                                <Run Text="/20"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- Serie B Tab -->
            <TabItem Header="🔵 Serie B" Background="#2d2d2d" Foreground="#4a9eff">
                <Grid Background="#1e1e1e">
                    <ListBox x:Name="SerieBList" 
                             Background="#2a2a2a"
                             Foreground="White"
                             BorderBrush="#444444"
                             SelectedValuePath="Id">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1e1e1e" Padding="10" BorderBrush="#444444" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                                   Text="{Binding Abbreviation}" 
                                                   FontSize="16" 
                                                   FontWeight="Bold"
                                                   Foreground="#ffd700"
                                                   Width="50"
                                                   TextAlignment="Center"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                            <TextBlock Text="{Binding City}" FontSize="11" Foreground="#888888"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="15,0,0,0">
                                            <TextBlock FontSize="10" Foreground="#888888">
                                                <Run Text="💰 "/>
                                                <Run Text="{Binding BudgetInMillions}"/>
                                                <Run Text=" M"/>
                                            </TextBlock>
                                            <TextBlock FontSize="10" Foreground="#888888">
                                                <Run Text="⭐ "/>
                                                <Run Text="{Binding Reputation}"/>
                                                <Run Text="/20"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- Serie C Tab -->
            <TabItem Header="🟡 Serie C" Background="#2d2d2d" Foreground="#ffd700">
                <Grid Background="#1e1e1e">
                    <ListBox x:Name="SerieCList" 
                             Background="#2a2a2a"
                             Foreground="White"
                             BorderBrush="#444444"
                             SelectedValuePath="Id">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1e1e1e" Padding="10" BorderBrush="#444444" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                                   Text="{Binding Abbreviation}" 
                                                   FontSize="16" 
                                                   FontWeight="Bold"
                                                   Foreground="#ffd700"
                                                   Width="50"
                                                   TextAlignment="Center"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                            <TextBlock Text="{Binding City}" FontSize="11" Foreground="#888888"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="15,0,0,0">
                                            <TextBlock FontSize="10" Foreground="#888888">
                                                <Run Text="💰 "/>
                                                <Run Text="{Binding BudgetInMillions}"/>
                                                <Run Text=" M"/>
                                            </TextBlock>
                                            <TextBlock FontSize="10" Foreground="#888888">
                                                <Run Text="⭐ "/>
                                                <Run Text="{Binding Reputation}"/>
                                                <Run Text="/20"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Club Details & Buttons -->
        <Border Grid.Row="3" Background="#2a2a2a" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Selected Club Info -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="SelectedClubName" Text="Select a club to begin" FontSize="18" FontWeight="Bold" Foreground="#00d4ff"/>
                    <TextBlock x:Name="SelectedClubInfo" Text="" FontSize="12" Foreground="#888888" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="← BACK" 
                            Height="40" 
                            Width="100"
                            FontSize="12"
                            FontWeight="Bold"
                            Background="#666666"
                            Foreground="White"
                            Cursor="Hand"
                            Click="Back_Click"
                            Margin="0,0,10,0"/>

                    <Button Content="START GAME →" 
                            Height="40" 
                            Width="140"
                            FontSize="12"
                            FontWeight="Bold"
                            Background="#00d4ff"
                            Foreground="#000000"
                            Cursor="Hand"
                            Click="StartGame_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
