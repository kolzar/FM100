<UserControl x:Class="FM100.Views.ClubSelectionView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Background="{DynamicResource PrimaryBackgroundBrush}"
            FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource SecondaryBackgroundBrush}" Padding="20">
            <TextBlock Text="🏆 Choose Your Club" 
                       FontSize="32" 
                       FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}"/>
        </Border>

        <!-- Difficulty Selection -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBackgroundBrush}" Padding="20" HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Difficulty: " FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="DifficultyCombo" Width="100" Height="30" Foreground="Black">
                    <ComboBoxItem Content="Easy" IsSelected="False"/>
                    <ComboBoxItem Content="Normal" IsSelected="True"/>
                    <ComboBoxItem Content="Hard" IsSelected="False"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- Division Tabs & Club Lists -->
        <TabControl Grid.Row="2" Background="{DynamicResource PrimaryBackgroundBrush}" Foreground="{DynamicResource SecondaryTextBrush}">
            <!-- Serie A Tab -->
            <TabItem Header="Serie A" Background="{DynamicResource SecondaryBackgroundBrush}" Foreground="{DynamicResource SecondaryTextBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- Clubs List -->
                    <ListBox x:Name="SerieAList" 
                             Background="{DynamicResource PrimaryBackgroundBrush}" 
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="{Binding City}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Info Panel -->
                    <Border Grid.Column="1" Background="{DynamicResource PanelBackgroundBrush}" Padding="20" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Selected Club" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>
                            <TextBlock x:Name="SelectedClubName" Text="None" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBlock x:Name="SelectedClubInfo" Text="" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Serie B Tab -->
            <TabItem Header="Serie B" Background="{DynamicResource SecondaryBackgroundBrush}" Foreground="{DynamicResource SecondaryTextBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <ListBox x:Name="SerieBList" 
                             Background="{DynamicResource PrimaryBackgroundBrush}" 
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="{Binding City}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Column="1" Background="{DynamicResource PanelBackgroundBrush}" Padding="20" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Selected Club" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>
                            <TextBlock x:Name="SelectedClubName_Copy1" Text="None" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBlock x:Name="SelectedClubInfo_Copy1" Text="" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Serie C Tab -->
            <TabItem Header="Serie C" Background="{DynamicResource SecondaryBackgroundBrush}" Foreground="{DynamicResource SecondaryTextBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <ListBox x:Name="SerieCList" 
                             Background="{DynamicResource PrimaryBackgroundBrush}" 
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="{Binding City}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Column="1" Background="{DynamicResource PanelBackgroundBrush}" Padding="20" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Selected Club" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>
                            <TextBlock x:Name="SelectedClubName_Copy2" Text="None" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBlock x:Name="SelectedClubInfo_Copy2" Text="" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Buttons -->
        <Border Grid.Row="3" Background="{DynamicResource SecondaryBackgroundBrush}" Padding="20">
            <Grid HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="StartButton" 
                        Grid.Column="0"
                        Click="StartGame_Click" 
                        Background="{DynamicResource AccentBrush}" 
                        Foreground="{DynamicResource InverseTextBrush}" 
                        Padding="15,8" 
                        FontSize="14"
                        FontWeight="Bold">
                    Start Game
                </Button>
                <Button x:Name="BackButton" 
                        Grid.Column="2"
                        Click="Back_Click" 
                        Background="{DynamicResource TertiaryBackgroundBrush}" 
                        Foreground="{DynamicResource PrimaryTextBrush}" 
                        Padding="15,8" 
                        FontSize="14">
                    Back
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
