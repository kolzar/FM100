<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <SolidColorBrush x:Key="AccentBrush" Color="#00d4ff"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="#00e6ff"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#0099aa"/>

    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="#1a1a2e"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#0f0f1e"/>
    <SolidColorBrush x:Key="TertiaryBackgroundBrush" Color="#3a3a6e"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1a1f3a"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#2d2d2d"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#2d3561"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#000000"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#b0b0b0"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#888888"/>
    <SolidColorBrush x:Key="InverseTextBrush" Color="#000000"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#cc3333"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#00a86b"/>

    <sys:Double x:Key="TitleFontSize">32</sys:Double>
    <sys:Double x:Key="SubtitleFontSize">24</sys:Double>
    <sys:Double x:Key="LargeFontSize">16</sys:Double>
    <sys:Double x:Key="NormalFontSize">14</sys:Double>
    <sys:Double x:Key="SmallFontSize">12</sys:Double>

    <Thickness x:Key="SmallMargin">5</Thickness>
    <Thickness x:Key="NormalMargin">10</Thickness>
    <Thickness x:Key="LargeMargin">20</Thickness>
    <Thickness x:Key="ExtraLargeMargin">40</Thickness>

</ResourceDictionary>
