<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <SolidColorBrush x:Key="AccentBrush" Color="#006f9f"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="#0b86bd"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#005678"/>

    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="#f5f7fb"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="TertiaryBackgroundBrush" Color="#dce6f2"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#eef3f8"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#bfd0df"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#ffffff"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#17212b"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#4f6375"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#6e7f90"/>
    <SolidColorBrush x:Key="InverseTextBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#b72d2d"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#14875a"/>

    <sys:Double x:Key="TitleFontSize">32</sys:Double>
    <sys:Double x:Key="SubtitleFontSize">24</sys:Double>
    <sys:Double x:Key="LargeFontSize">16</sys:Double>
    <sys:Double x:Key="NormalFontSize">14</sys:Double>
    <sys:Double x:Key="SmallFontSize">12</sys:Double>

    <Thickness x:Key="SmallMargin">5</Thickness>
    <Thickness x:Key="NormalMargin">10</Thickness>
    <Thickness x:Key="LargeMargin">20</Thickness>
    <Thickness x:Key="ExtraLargeMargin">40</Thickness>

</ResourceDictionary>
